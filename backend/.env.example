# ResQNet Backend Configuration
# Copy this file to .env and configure for your environment

# Application
APP_NAME="ResQNet API"
ENVIRONMENT=development
# In production, set SEED_DEMO_DATA=false and use a unique SECRET_KEY (32+ characters).
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
DATABASE_URL=sqlite:///./resqnet.db
# For production: DATABASE_URL=postgresql://user:password@localhost/resqnet

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Data
SEED_DEMO_DATA=true

# AI Features (Optional)
GEMINI_API_KEY=
# Get from: https://aistudio.google.com/app/apikey

WHISPER_API_KEY=
# Get from: https://platform.openai.com/api-keys

# Upload Directory
UPLOAD_DIR=uploads
# Keep uploads on persistent private storage; never expose this directory directly.
